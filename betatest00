let db=loadDB(),draft=loadDraft(),selectedTeam=null,currentTeam=null,spinBusy=false,slotAssignment=null; if(!FORMATIONS[draft.formation]){draft={picks:[],formation:'3-3-3',history:[]};saveDraft()} if(draft.picks.length>13){draft={picks:[],formation:'3-3-3',history:[]};saveDraft()}
function loadDB(){try{return JSON.parse(localStorage.getItem('vrfsBestXIDB'))||{teams:[]}}catch{return {teams:[]}}}function loadDraft(){try{return JSON.parse(localStorage.getItem('vrfsBestXIDraft'))||{picks:[],formation:'3-3-3',history:[]}}catch{return {picks:[],formation:'3-3-3',history:[]}}}
