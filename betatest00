function saveDB(){localStorage.setItem('vrfsBestXIDB',JSON.stringify(db));if(sharedDBReady&&authReady&&authUser&&(authRole==='admin'||authRole==='owner'))syncSharedDB().catch(e=>console.warn('Shared database sync:',e.message));}function saveDraft(){localStorage.setItem('vrfsBestXIDraft',JSON.stringify(draft))}function toast(msg){let t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2400)}
function showTab(tab){document.getElementById('draft').classList.toggle('hide',tab!=='draft');document.getElementById('admin').classList.toggle('show',tab==='admin');document.getElementById('ucl').classList.toggle('show',tab==='ucl');document.getElementById('profile').classList.toggle('show',tab==='profile');document.getElementById('draftNav').classList.toggle('active',tab==='draft');document.getElementById('adminNav').classList.toggle('active',tab==='admin');document.getElementById('uclNav').classList.toggle('active',tab==='ucl');if(tab==='admin')renderAdmin();if(tab==='ucl')renderUCL();if(tab==='profile')renderProfile()}
function addTeam(){let name=document.getElementById('newTeamName').value.trim();if(!name)return toast('Enter a team name first.');if(db.teams.some(t=>t.name.toLowerCase()===name.toLowerCase()))return toast('That team already exists.');let team={id:crypto.randomUUID(),name,players:[]};db.teams.push(team);selectedTeam=team.id;document.getElementById('newTeamName').value='';saveDB();renderAdmin();renderStats();toast('Team added.')}
const BETA_DEMO_CLUB_NAMES = ['Northvale FC','Westbridge United','Redmont Athletic','Kingsford City','Silverlake SC','Eastmoor Rovers','Stonehaven FC','Ashford Union'];
function isBetaDemoTeam(team){return !!team&&(team.betaDemo===true||team.betaQuick===true||BETA_DEMO_CLUB_NAMES.some(n=>n.toLowerCase()===String(team.name||'').trim().toLowerCase().replace(/\s+/g,' ')));}
function addBetaTeams(){if(db.teams.some(t=>t.betaDemo))return toast('Beta demo clubs are already loaded.');const clubs=[['Northvale FC',['Milo Varek','Jonas Elwick','Rian Solberg','Tomas Kade','Eli Navarro','Dario Venn','Nico Ardent','Soren Vale','Luca Ren','Ari Bell'],['GK','CB','CB','LB','RB','CDM','CM','CAM','LW','ST']],['Westbridge United',['Kai Mercer','Noah Rellan','Finn Calder','Leo Marwick','Cruz Aven','Theo Baird','Ivo Renn','Mason Kiro','Evan Dorne','Jude Alcott'],['GK','CB','CB','LB','RB','CM','CM','CAM','RW','ST']],['Redmont Athletic',['Ezra Voss','Caleb Orin','Axel Miro','Dylan Faye','Remy Sol','Pavel Nox','Arlo Kess','Tate Rowan','Sami Lorne','Owen Rusk'],['GK','CB','CB','RB','LB','CDM','CM','CAM','LW','ST']],['Kingsford City',['Bren Lasko','Mika Orrel','Aden Cross','Rory Vale','Kellan Dray','Zane Holt','Lio Maren','Cody Evers','Timo Ash','Nolan Greer'],['GK','CB','CB','LB','RB','CDM','CM','CAM','RW','ST']],['Silverlake SC',['Dax Weller','Emil Rove','Kian Drest','Bruno Hale','Nate Kellan','Omar Vey','Felix Arden','Yuri Moss','Cal Riven','Ilan Tor'],['GK','CB','CB','RB','LB','CM','CM','CAM','LW','ST']],['Eastmoor Rovers',['Alec Vire','Piero Senn','Lars Daven','Rafael Korr','Benji Wren','Cai Mercer','Hugo Linn','Vito Sol','Marcel Quinn','Tariq Venn'],['GK','CB','CB','LB','RB','CDM','CM','CAM','RW','ST']],['Stonehaven FC',['Eren Vale','Matteo Crest','Jace Arlow','Sven Neri','Liam Kest','Drew Malk','Rafi Orson','Toby Hane','Iker Solis','Milo Renn'],['GK','CB','CB','RB','LB','CDM','CM','CAM','LW','ST']],['Ashford Union',['Cian Vero','Ruben Knox','Kobe Saren','Theo Mav','Ari Kellan','Nico Brant','Dario West','Eli Rovan','Jules Arin','Kai Lorne'],['GK','CB','CB','LB','RB','CM','CM','CAM','RW','ST']]];const positionMap={GK:['GK'],CB:['CB'],LB:['LB'],RB:['RB'],CDM:['CDM','CM'],CM:['CM','CAM'],CAM:['CAM','CM'],LW:['LW','ST'],RW:['RW','ST'],ST:['ST','LW']};clubs.forEach((c,ci)=>{let names=c[1],roles=c[2];let roster=names.map((name,i)=>({id:'beta-'+ci+'-'+i+'-'+crypto.randomUUID(),name,rating:Math.floor(62+Math.random()*33),positions:positionMap[roles[i]]||[roles[i]]}));db.teams.push({id:'beta-club-'+ci+'-'+crypto.randomUUID(),name:c[0],players:roster,betaDemo:true});});saveDB();selectedTeam=db.teams.find(t=>t.betaDemo)?.id||null;renderAdmin();renderStats();toast('Beta demo clubs added!')}async function clearBetaTeams(){const betaTeams=db.teams.filter(isBetaDemoTeam);if(!betaTeams.length)return toast('No Beta clubs to remove.');const betaIds=new Set(betaTeams.map(t=>t.id));if(draft.picks.some(p=>betaIds.has(p.teamId)||BETA_DEMO_CLUB_NAMES.some(n=>String(p.teamName||'').toLowerCase()===n.toLowerCase())))return toast('Reset your draft first to remove Beta clubs used in picks.');db.teams=db.teams.filter(t=>!isBetaDemoTeam(t));if(selectedTeam&&!db.teams.some(t=>t.id===selectedTeam))selectedTeam=db.teams[0]?.id||null;saveDB();renderAdmin();renderStats();try{await removeBetaTeamsFromSharedDB();toast('Beta clubs and their players removed. Your real clubs were kept.')}catch(e){console.warn('Beta cleanup failed:',e.message);toast('Beta clubs removed locally, but Supabase cleanup failed. Check database permissions.')}}function deleteTeam(id){let team=db.teams.find(t=>t.id===id);if(!team)return;if(!confirm(`Delete ${team.name} and its roster?`))return;db.teams=db.teams.filter(t=>t.id!==id);if(selectedTeam===id)selectedTeam=db.teams[0]?.id||null;saveDB();renderAdmin();renderStats();}
function selectTeamAdmin(id){selectedTeam=id;renderAdmin()}
function renderAdmin(){document.getElementById('adminTeamCount').textContent=db.teams.length;let list=document.getElementById('teamList');list.innerHTML=db.teams.length?db.teams.map(t=>`<button class="teamrow ${selectedTeam===t.id?'active':''}" onclick="selectTeamAdmin('${t.id}')"><span>${t.logo?`<img class="teamlogo" src="${t.logo}">`:''}${esc(t.name)}</span><span class="pill">${t.players.length}</span></button>`).join(''):'<div class="empty">No teams added yet.</div>';let team=db.teams.find(t=>t.id===selectedTeam);let editor=document.getElementById('adminEditor');if(!team){document.getElementById('adminRosterTitle').textContent='Team roster editor';document.getElementById('playerCount').textContent='0 PLAYERS';editor.innerHTML='<div class="empty">Create or select a team to manage its roster.</div>';return}document.getElementById('adminRosterTitle').textContent=team.name;document.getElementById('playerCount').textContent=team.players.length+' PLAYERS';editor.innerHTML=`<div class="logoupload"><div id="teamLogoPreview">${team.logo?`<img class="teamlogo preview" src="${team.logo}">`:`<div class="teamlogo preview" style="display:grid;place-items:center;color:var(--muted)">CREST</div>`}</div><div class="field"><label>Team logo (optional)</label><input type="file" id="teamLogoFile" accept="image/png,image/jpeg,image/webp,image/gif" onchange="uploadTeamLogo('${team.id}',this)"><small class="small">PNG, JPG, WebP, or GIF. Images are resized to save space.</small></div>${team.logo?`<button type="button" onclick="removeTeamLogo('${team.id}')">Remove logo</button>`:''}</div><div class="formgrid"><div class="field"><label>Player name</label><input id="pname" placeholder="Name"></div><div class="field"><label>Rating</label><input id="prating" type="number" min="1" max="99" placeholder="e.g. 87"></div></div><div class="field" style="margin-top:12px"><label>Positions (select all that apply)</label><div class="positions">${POS.map(p=>`<label class="poscheck"><input type="checkbox" name="pPos" value="${p}">${p}</label>`).join('')}</div></div><div class="actions"><button class="primary" onclick="addPlayer('${team.id}')">+ Add player to roster</button><button class="danger" onclick="deleteTeam('${team.id}')">Delete team</button></div><div class="adminroster" id="adminRoster"></div>`;let roster=document.getElementById('adminRoster');roster.innerHTML=team.players.length?team.players.map(p=>`<div class="adminplayer"><div><strong>${esc(p.name)} <span class="rating">${p.rating}</span></strong><small>${p.positions.join(' · ')}</small><div class="ratingmeter"><i style="width:${p.rating}%"></i></div></div><button class="danger" onclick="deletePlayer('${team.id}','${p.id}')">Remove</button></div>`).join(''):'<div class="empty" style="grid-column:1/-1">Roster is empty. Add players above.</div>'}
function uploadTeamLogo(teamId,input){let file=input.files&&input.files[0];if(!file)return;if(!file.type.startsWith('image/'))return toast('Please choose an image file.');let team=db.teams.find(t=>t.id===teamId);if(!team)return;let reader=new FileReader();reader.onload=()=>{let img=new Image();img.onload=()=>{let canvas=document.createElement('canvas');let size=320;canvas.width=size;canvas.height=size;let ctx=canvas.getContext('2d');ctx.clearRect(0,0,size,size);let scale=Math.min(size/img.width,size/img.height);let w=img.width*scale,h=img.height*scale;ctx.drawImage(img,(size-w)/2,(size-h)/2,w,h);let data=canvas.toDataURL('image/webp',0.82);team.logo=data;try{saveDB();renderAdmin();renderStats();toast('Team logo saved.')}catch(e){team.logo=null;toast('Logo is too large for browser storage. Try a smaller image.')}};img.onerror=()=>toast('Could not load that image.');img.src=reader.result};reader.onerror=()=>toast('Could not read image.');reader.readAsDataURL(file)}
function removeTeamLogo(teamId){let team=db.teams.find(t=>t.id===teamId);if(!team)return;team.logo=null;saveDB();renderAdmin();toast('Team logo removed.')}
function addPlayer(teamId){let t=db.teams.find(t=>t.id===teamId);let name=document.getElementById('pname').value.trim(),rating=parseInt(document.getElementById('prating').value),positions=[...document.querySelectorAll('input[name=pPos]:checked')].map(x=>x.value);if(!name)return toast('Enter the player name.');if(!Number.isFinite(rating)||rating<1||rating>99)return toast('Rating must be between 1 and 99.');if(!positions.length)return toast('Assign at least one position.');if(t.players.some(p=>p.name.toLowerCase()===name.toLowerCase()))return toast('Player already exists on this roster.');t.players.push({id:crypto.randomUUID(),name,rating,positions});saveDB();renderAdmin();renderStats();toast('Player added to roster.')}
