const FORMATIONS={
 '3-3-3':[{pos:'LW',x:0},{pos:'ST',x:1},{pos:'RW',x:2},{pos:'CM',x:3},{pos:'CM',x:4},{pos:'CM',x:5},{pos:'CB',x:6},{pos:'CB',x:7},{pos:'CB',x:8},{pos:'GK',x:9}],
