function createLeagueRounds(teams){
  // Circle-method round robin: 8 clubs, 7 matchdays, every opponent exactly once.
  let arr=shuffle(teams),rounds=[];if(arr.length%2)arr.push(null);const n=arr.length;
  for(let round=0;round<n-1;round++){let matches=[];for(let i=0;i<n/2;i++){let a=arr[i],b=arr[n-1-i];if(a&&b){if((round+i)%2)matches.push({home:b.id,away:a.id,result:null});else matches.push({home:a.id,away:b.id,result:null})}}rounds.push(matches);arr=[arr[0],arr[n-1],...arr.slice(1,n-1)]}
  return rounds;
}
