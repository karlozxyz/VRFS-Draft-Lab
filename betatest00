function randomAIStartingXI(){
  const pool=shuffle(db.teams.flatMap(t=>t.players.map(p=>({...p,originTeam:t.name}))).filter(p=>Array.isArray(p.positions)&&p.positions.length));
  const roles=['GK','DEF','DEF','DEF','MID','MID','MID','ATT','ATT','ATT'];
  const chosen=[],used=new Set();
  // Randomized backtracking ensures every player is assigned to a role they are registered for.
  function fill(index){if(index===roles.length)return true;let role=roles[index],options=shuffle(pool.filter(p=>!used.has(p.id)&&p.positions.some(pos=>positionGroup(pos)===role)));for(let p of options){used.add(p.id);let playable=p.positions.filter(pos=>positionGroup(pos)===role);chosen[index]={...p,assigned:randItem(playable)};if(fill(index+1))return true;used.delete(p.id);chosen[index]=null}return false}
  if(!fill(0))return null;
  let remaining=shuffle(pool.filter(p=>!used.has(p.id))),bench=[];
  for(let i=0;i<3&&remaining.length;i++){let p=remaining.pop();bench.push({...p,assigned:p.positions[0]})}
  let lineup=chosen.map((p,i)=>({...p,role:roles[i]}));
  return {lineup,bench,rating:Math.round(lineup.reduce((sum,p)=>sum+(Number(p.rating)||0),0)/lineup.length)}
}
