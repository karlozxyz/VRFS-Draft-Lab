function randItem(a){return a[Math.floor(Math.random()*a.length)]}
function shuffle(a){let b=a.slice();for(let i=b.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[b[i],b[j]]=[b[j],b[i]]}return b}
function positionGroup(pos){if(pos==='GK')return 'GK';if(['CB','LB','RB','LWB','RWB'].includes(pos))return 'DEF';if(['CDM','CM','CAM','LM','RM'].includes(pos))return 'MID';if(['LW','RW','ST'].includes(pos))return 'ATT';return null}
function randomAIStartingXI(){
  const pool=shuffle(db.teams.flatMap(t=>t.players.map(p=>({...p,originTeam:t.name}))).filter(p=>Array.isArray(p.positions)&&p.positions.length));
  // Pick a real formation so wide roles stay distinct; only positions repeated by
  // the formation itself (such as CM or CB) can appear more than once.
  const formationNames=Object.keys(FORMATIONS),formation=FORMATIONS[randItem(formationNames)];
  const chosen=[],used=new Set();
  // Backtracking assigns each slot its exact displayed position while allowing
  // players registered in a compatible position group to fill that slot.
  function fill(index){if(index===formation.length)return true;const slot=formation[index],role=positionGroup(slot.pos);const options=shuffle(pool.filter(p=>!used.has(p.id)&&p.positions.some(pos=>positionGroup(pos)===role)));for(const p of options){used.add(p.id);chosen[index]={...p,assigned:slot.pos,role};if(fill(index+1))return true;used.delete(p.id);chosen[index]=null}return false}
  if(!fill(0))return null;
  const remaining=shuffle(pool.filter(p=>!used.has(p.id))),bench=[];
  for(let i=0;i<3&&remaining.length;i++){const p=remaining.pop();bench.push({...p,assigned:p.positions[0]})}
  const lineup=chosen;
