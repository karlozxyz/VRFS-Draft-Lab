function loadDB(){
 let saved;try{saved=JSON.parse(localStorage.getItem('vrfsBestXIDB'))}catch{saved=null}
 saved=saved&&Array.isArray(saved.teams)?saved:{teams:[]};
 // One-time recovery: restore the user's actual uploaded 10-club / 124-player backup.
 if(!localStorage.getItem('vrfsBackupTeamsRestoredV1')){
   const byName=new Map(saved.teams.map(t=>[String(t.name||'').trim().toLowerCase(),t]));
   for(const source of (VRFS_BACKUP_DATABASE.teams||[])){
     const key=String(source.name||'').trim().toLowerCase();
     if(!byName.has(key)){const copy=JSON.parse(JSON.stringify(source));copy.rarity=copy.rarity||'Common';saved.teams.push(copy);byName.set(key,copy);}
     else {const existing=byName.get(key);existing.players=Array.isArray(existing.players)?existing.players:[];for(const player of (source.players||[])){if(!existing.players.some(p=>String(p.name||'').toLowerCase()===String(player.name||'').toLowerCase()))existing.players.push(JSON.parse(JSON.stringify(player)));}if(!existing.logo&&source.logo)existing.logo=source.logo;if(!existing.rarity)existing.rarity='Common';}
   }
   localStorage.setItem('vrfsBestXIDB',JSON.stringify(saved));
   localStorage.setItem('vrfsBackupTeamsRestoredV1','1');
 }
 return saved;
