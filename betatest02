async function refreshAuthProfile(user){
 authUser=user||null;authRole='member';authReady=false;updateAuthUI();
 if(user){
  const {data,error}=await sbClient.from('profiles').select('role,banned').eq('id',user.id).maybeSingle();
  if(error){console.warn('Profile lookup failed:',error.message);authRole='member';}
  else if(data){if(data.banned){await sbClient.auth.signOut();authUser=null;authRole='member';toast('This account is currently blocked.');}else authRole=data.role||'member';}
  if(authUser?.user_metadata?.username){sbClient.rpc('set_my_username',{desired_username:authUser.user_metadata.username}).then(({error})=>{if(error)console.warn('Username sync pending:',error.message);});}
 }
 authReady=true;updateAuthUI();
 // Load the public club catalogue for guests too. Signing in is only needed for
 // account features and Admin editing; it must not be required just to see clubs.
 await loadSharedDB();
}
async function authLogin(){const email=document.getElementById('authEmail').value.trim(),password=document.getElementById('authPassword').value;if(!email||!password)return setAuthError('Enter your email and password.');setAuthError('');const {error}=await sbClient.auth.signInWithPassword({email,password});if(error)return setAuthError(error.message);closeAuthModal();toast('Signed in successfully.');}
async function authSignup(){document.getElementById('usernameField').classList.add('show');const username=document.getElementById('authUsername').value.trim(),email=document.getElementById('authEmail').value.trim(),password=document.getElementById('authPassword').value;if(!username)return setAuthError('Choose a username first.');if(!/^[a-zA-Z0-9_]{3,20}$/.test(username))return setAuthError('Username must be 3–20 letters, numbers, or underscores.');if(!email||!password)return setAuthError('Enter your email and password.');if(password.length<6)return setAuthError('Password must be at least 6 characters.');setAuthError('');const {data,error}=await sbClient.auth.signUp({email,password,options:{emailRedirectTo:'https://karlozxyz.github.io/VRFS-Draft-Lab/',data:{username}}});if(error)return setAuthError(error.message);if(data.session){closeAuthModal();toast('Account created and signed in.');}else setAuthError('Account created! Check your email to confirm, then log in.');}
async function authSignOut(){const {error}=await sbClient.auth.signOut();if(error)toast(error.message);else toast('Signed out.');}
async function renderProfile(){const panel=document.getElementById('profilePanel');if(!authUser){panel.innerHTML='<div class="empty">Log in to see your profile and leaderboard.</div>';return;}const username=authUser.user_metadata?.username||authUser.email?.split('@')[0]||'Player';let wins=Number(localStorage.getItem('vrfsUCLWins')||0);let leaderboard=[];try{const {data,error}=await sbClient.rpc('get_ucl_leaderboard');if(!error&&data){leaderboard=data;const mine=data.find(x=>x.username===username);if(mine)wins=Number(mine.ucl_wins||0);}}catch{}panel.innerHTML=`<div class="profilegrid"><div class="profilestat"><strong>${escSafe(username)}</strong><small>Username</small></div><div class="profilestat"><strong>🏆 ${wins}</strong><small>UCL wins (shared account stat)</small></div></div><h3 style="margin-top:18px">UCL Leaderboard</h3>${leaderboard.length?`<table class="profiletable"><thead><tr><th>#</th><th>Username</th><th>UCL wins</th></tr></thead><tbody>${leaderboard.map((x,i)=>`<tr><td>${i+1}</td><td>${escSafe(x.username||'Player')}</td><td>${Number(x.ucl_wins||0)}</td></tr>`).join('')}</tbody></table>`:'<p class="uclnote">Leaderboard will appear once the shared profile stats database is set up.</p>'}<p class="uclnote">Beta note: local trophy totals are not yet verified or synced to the shared leaderboard.</p>`;}
function escSafe(value){return String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
const originalShowTab=showTab;
showTab=function(tab){originalShowTab(tab);};
sbClient.auth.onAuthStateChange((_event,session)=>{refreshAuthProfile(session?.user||null);});
sbClient.auth.getSession().then(({data})=>refreshAuthProfile(data.session?.user||null));
</script></body></html>
